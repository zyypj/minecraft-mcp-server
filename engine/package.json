{
  "name": "@mcbuild/engine",
  "version": "0.1.0",
  "description": "The Build Engine: a deterministic, seeded, rule-driven pipeline that turns architectural intent into Minecraft 1.8 voxel builds, legacy .schematic files and analysis reports. Zero runtime dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "ava"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ],
    "files": [
      "test/**/*.ts"
    ],
    "timeout": "180s",
    "concurrency": 2
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ava": "^6.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
